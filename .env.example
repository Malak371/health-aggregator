# Copy to .env for local development. Never commit the real .env file.

# --- Backend ---------------------------------------------------------------
# SQLite locally; in production set a PostgreSQL URL, for example
# postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=sqlite:///./health.db

# Comma-separated list of origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:8501

# Load the bundled synthetic dataset on first start so the demo is never empty.
SEED_DEMO_DATA=true

# Largest accepted upload, in megabytes.
MAX_UPLOAD_MB=20

# Uploaded datasets are deleted after this many hours.
UPLOAD_TTL_HOURS=24

# --- Frontend --------------------------------------------------------------
# Where the Streamlit dashboard finds the API.
BACKEND_URL=http://localhost:8000

# --- docker compose only ---------------------------------------------------
POSTGRES_USER=health
POSTGRES_PASSWORD=change-me
POSTGRES_DB=health
